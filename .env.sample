# ----------------------------------------------------------------------------
# Amr & Suzan — environment variables
# Copy this file to `.env.local` and fill in the value(s) below.
#   cp .env.sample .env.local
# ----------------------------------------------------------------------------

# The public, canonical URL of the deployed site (no trailing slash).
# Used for SEO: canonical tag, OpenGraph/Twitter URLs, JSON-LD, and sitemap.
# Until you deploy, the app falls back to https://amr-suzan-wedding.vercel.app
# On Vercel: set this in Project Settings → Environment Variables.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
